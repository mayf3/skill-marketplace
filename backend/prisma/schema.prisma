generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  publisher
  user
}

enum UserStatus {
  active
  disabled
}

enum SkillStatus {
  draft
  pending_review
  approved
  rejected
  published
  archived
}

enum SkillVisibility {
  public
  internal
}

enum FileType {
  source_code
  icon
  screenshot
  document
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  password     String
  role         UserRole     @default(user)
  avatar       String?
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  skills       Skill[]
  applications Application[]
  reviewedApplications Application[] @relation("ApplicationReviewer")
  reviews      Review[]

  @@map("users")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  skills      Skill[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Skill {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  version      String           @default("1.0.0")
  description  String
  readme       String?          @db.Text
  authorId     String           @db.Uuid
  author       User             @relation(fields: [authorId], references: [id])
  categoryId   String           @db.Uuid
  category     Category         @relation(fields: [categoryId], references: [id])
  tags         String[]         @default([])
  homepageUrl  String?
  repoUrl      String?
  logoUrl      String?
  screenshots  String[]         @default([])
  status       SkillStatus      @default(draft)
  visibility   SkillVisibility  @default(public)
  downloads    Int              @default(0)
  rating       Decimal          @default(0) @db.Decimal(3, 2)
  reviewCount  Int              @default(0)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  files        SkillFile[]
  applications Application[]
  reviews      Review[]

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@map("skills")
}

model SkillFile {
  id        String   @id @default(uuid()) @db.Uuid
  skillId   String   @db.Uuid
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  fileType  FileType
  fileUrl   String
  fileName  String
  fileSize  Int
  checksum  String?
  createdAt DateTime @default(now())

  @@index([skillId])
  @@map("skill_files")
}

model Application {
  id          String             @id @default(uuid()) @db.Uuid
  skillId     String             @db.Uuid
  skill       Skill              @relation(fields: [skillId], references: [id])
  applicantId String             @db.Uuid
  applicant   User               @relation(fields: [applicantId], references: [id])
  status      ApplicationStatus  @default(pending)
  reason      String?            @db.Text
  reviewedBy  String?            @db.Uuid
  reviewer    User?              @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  reviewNote  String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([skillId, applicantId])
  @@index([skillId])
  @@index([applicantId])
  @@index([status])
  @@map("applications")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  skillId   String   @db.Uuid
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([skillId, userId])
  @@index([skillId])
  @@map("reviews")
}
